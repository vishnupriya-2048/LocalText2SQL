# Copy to .env. Database credentials are entered on the connection screen, not here.

# --- Connection screen defaults (optional; never put the password here) ---
DB_TYPE=postgresql
DB_HOST=localhost:5432
DB_NAME=
DB_USER=

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hf.co/mradermacher/XiYanSQL-QwenCoder-7B-2504-GGUF:Q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=600
OLLAMA_KEEP_ALIVE=10m

# --- Hindsight (long-term memory; leave URL empty to run without memory) ---
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# true = don't wait for Hindsight's own LLM to process a memory (it then competes for CPU)
HINDSIGHT_RETAIN_ASYNC=false

# --- Agent ---
MAX_REPAIR_ATTEMPTS=2
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_S=30
# Sample rows per table shown to the model as example values (0 = none)
SCHEMA_SAMPLE_ROWS=3
# Distinct values shown per text column, found by scanning at most SCHEMA_SCAN_ROWS rows
SCHEMA_DISTINCT_VALUES=6
SCHEMA_SCAN_ROWS=50000
# Schemas with at most this many tables are sent whole; larger ones are filtered
SCHEMA_FULL_THRESHOLD=8
SCHEMA_MAX_TABLES=6
# Audit columns hidden from the model (comma-separated, case-insensitive)
SCHEMA_HIDDEN_COLUMNS=LastEditedBy,LastEditedWhen,ValidFrom,ValidTo
# Previous turns included for follow-up questions
HISTORY_TURNS=3

# --- Tests / benchmark (optional) ---
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/scratch_db
# RUN_OLLAMA_TESTS=1
# BENCHMARK_DATABASE_URL=postgresql://user:password@localhost:5432/{db_id}
